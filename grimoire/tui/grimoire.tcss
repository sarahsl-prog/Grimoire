/* Colours come from Textual's theme variables, so light and dark themes both
   work and the app follows whichever theme is active. */

/* Take only the space left after the header, status bar and key bar.  With the
   default auto height the tab area is one row too tall and the last row of every
   pane sits underneath the docked footer. */
TabbedContent {
    height: 1fr;
}

StatusBar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

StatusBar.-checking {
    color: $warning;
}

StatusBar.-connected {
    color: $success;
}

StatusBar.-unreachable {
    color: $error;
}

/* -- Search / Ask pane ---------------------------------------------------- */

SearchPane {
    padding: 0 1;
}

#query-row, #options-row {
    height: 3;
}

#query-input {
    width: 1fr;
}

#run-button {
    margin-left: 1;
}

#mode-set {
    layout: horizontal;
    width: auto;
    height: 3;
    border: none;
    padding: 0;
}

#top-k-label {
    margin: 1 1 0 2;
}

#top-k {
    width: 8;
}

#spinner {
    width: 8;
    height: 1;
    margin: 1 0 0 2;
}

#status-line {
    height: auto;
    color: $text-muted;
}

#status-line.-error {
    color: $error;
}

#meta-line {
    height: auto;
    color: $text-muted;
}

#answer-box {
    height: auto;
    max-height: 40%;
    border: round $primary-muted;
    padding: 0 1;
}

#sources {
    height: 1fr;
}

#source-list {
    width: 40%;
}

#preview-scroll {
    width: 1fr;
    padding: 0 1;
    border-left: tall $primary-muted;
}

/* -- Documents pane ------------------------------------------------------- */

DocumentsPane {
    padding: 0 1;
}

/* One row, no border: the pane is short on a 24-line terminal. */
#doc-search {
    height: 1;
    border: none;
    padding: 0 1;
}

#doc-filters {
    height: 3;
}

#status-filter, #type-filter {
    width: 28;
    margin-right: 1;
}

#doc-status {
    height: auto;
    color: $text-muted;
}

#doc-status.-error {
    color: $error;
}

#documents-table {
    height: 1fr;
}

#documents-empty {
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#doc-footer {
    height: 1;
    color: $text-muted;
}

/* -- Document detail modal ------------------------------------------------ */

DocumentDetailScreen {
    align: center middle;
}

#detail-box {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#detail-heading {
    text-style: bold;
    margin-bottom: 1;
}

#detail-status {
    height: auto;
    color: $text-muted;
}

#detail-status.-error {
    color: $error;
}

#detail-scroll {
    height: auto;
    max-height: 100%;
}

#detail-grid {
    grid-size: 2;
    grid-columns: 14 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    height: auto;
}

.detail-key {
    color: $text-muted;
    text-style: bold;
}

.detail-value {
    height: auto;
}

#detail-error {
    color: $error;
}

#detail-hint {
    color: $text-muted;
    margin-top: 1;
}

#detail-close {
    margin-top: 1;
}

/* -- API key modal --------------------------------------------------------- */

ApiKeyScreen {
    align: center middle;
}

#apikey-box {
    width: 70%;
    max-width: 80;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#apikey-heading {
    text-style: bold;
    margin-bottom: 1;
}

#apikey-help {
    color: $text-muted;
    margin-bottom: 1;
}

#apikey-error {
    color: $error;
    height: auto;
}

#apikey-buttons {
    height: auto;
    margin-top: 1;
}

#apikey-buttons Button {
    margin-right: 2;
}

/* -- Categories pane ------------------------------------------------------- */

CategoriesPane {
    padding: 0 1;
}

#cat-toolbar {
    height: 3;
}

#cat-toolbar Button {
    margin-right: 2;
}

#cat-status {
    height: auto;
    color: $text-muted;
}

#cat-status.-error {
    color: $error;
}

#categories-table {
    height: 1fr;
}

#categories-empty {
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#cat-footer {
    height: auto;
    color: $text-muted;
}

/* -- New category modal ---------------------------------------------------- */

NewCategoryScreen {
    align: center middle;
}

#newcat-box {
    width: 70%;
    max-width: 80;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#newcat-heading {
    text-style: bold;
    margin-bottom: 1;
}

#newcat-error {
    color: $error;
    height: auto;
}

#newcat-buttons {
    height: auto;
    margin-top: 1;
}

#newcat-buttons Button {
    margin-right: 2;
}

/* -- Tag picker modal ------------------------------------------------------ */

TagPickerScreen {
    align: center middle;
}

#picker-box {
    width: 60%;
    max-width: 70;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#picker-heading {
    text-style: bold;
    margin-bottom: 1;
}

#picker-status {
    height: auto;
    color: $text-muted;
}

#picker-status.-error {
    color: $error;
}

#picker-list {
    height: auto;
    max-height: 14;
}

/* -- Ingest pane ----------------------------------------------------------- */

IngestPane {
    padding: 0 1;
}

#ingest-input-row {
    height: 3;
}

#ingest-path {
    width: 1fr;
}

#ingest-autotag {
    width: auto;
    margin-left: 1;
}

#ingest-status {
    height: auto;
    color: $text-muted;
}

#ingest-status.-error {
    color: $error;
}

#ingest-table {
    height: 1fr;
}

#ingest-empty {
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#ingest-footer {
    height: auto;
    color: $text-muted;
}
