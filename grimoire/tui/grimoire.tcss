/* Colours come from Textual's theme variables, so light and dark themes both
   work and the app follows whichever theme is active. */

/* Take only the space left after the header, status bar and key bar.  With the
   default auto height the tab area is one row too tall and the last row of every
   pane sits underneath the docked footer. */
TabbedContent {
    height: 1fr;
}

StatusBar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

StatusBar.-checking {
    color: $warning;
}

StatusBar.-connected {
    color: $success;
}

StatusBar.-unreachable {
    color: $error;
}

/* -- Search / Ask pane ---------------------------------------------------- */

SearchPane {
    padding: 0 1;
}

#query-row, #options-row {
    height: 3;
}

#query-input {
    width: 1fr;
}

#run-button {
    margin-left: 1;
}

#mode-set {
    layout: horizontal;
    width: auto;
    height: 3;
    border: none;
    padding: 0;
}

#top-k-label {
    margin: 1 1 0 2;
}

#top-k {
    width: 8;
}

#spinner {
    width: 8;
    height: 1;
    margin: 1 0 0 2;
}

#status-line {
    height: auto;
    color: $text-muted;
}

#status-line.-error {
    color: $error;
}

#meta-line {
    height: auto;
    color: $text-muted;
}

#answer-box {
    height: auto;
    max-height: 40%;
    border: round $primary-muted;
    padding: 0 1;
}

#sources {
    height: 1fr;
}

#source-list {
    width: 40%;
}

#preview-scroll {
    width: 1fr;
    padding: 0 1;
    border-left: tall $primary-muted;
}

/* -- Documents pane ------------------------------------------------------- */

DocumentsPane {
    padding: 0 1;
}

#doc-filters {
    height: 3;
}

#status-filter, #type-filter {
    width: 28;
    margin-right: 1;
}

#doc-status {
    height: auto;
    color: $text-muted;
}

#doc-status.-error {
    color: $error;
}

#documents-table {
    height: 1fr;
}

#documents-empty {
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#doc-footer {
    height: 1;
    color: $text-muted;
}
